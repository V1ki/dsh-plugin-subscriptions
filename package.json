{
  "name": "dsh-plugin-subscriptions",
  "version": "0.5.3",
  "description": "Use ChatGPT (Codex), Claude, Grok (X Premium), and GitHub Copilot subscriptions as DeepSeek Harness LLM providers, with OAuth login from the web Settings page",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/V1ki/dsh-plugin-subscriptions.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "llm",
    "oauth",
    "chatgpt",
    "codex",
    "claude",
    "grok",
    "github-copilot"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsdown",
    "test": "tsc -p tsconfig.test.json && node --test lib-test/test/",
    "prepare": "tsdown -c tsdown.prepare.config.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
