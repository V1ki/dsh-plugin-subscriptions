{
  "name": "dsh-plugin-subscriptions",
  "version": "0.9.13",
  "description": "Use ChatGPT (Codex), Claude, Grok (X Premium), GitHub Copilot, and Google Antigravity subscriptions as DeepSeek Harness LLM providers, with OAuth login from the web Settings page",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/V1ki/dsh-plugin-subscriptions.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "llm",
    "oauth",
    "chatgpt",
    "codex",
    "claude",
    "grok",
    "github-copilot",
    "google-antigravity"
  ],
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsdown",
    "test": "tsc -p tsconfig.test.json && node --test \"lib-test/test/**/*.spec.js\"",
    "prepare": "tsdown -c tsdown.prepare.config.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || 4.0.5-alpha.1 || 4.0.5-alpha.2",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.2 || >=0.2.1-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.2 || >=0.2.1-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 || >=0.2.1-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 || >=0.2.1-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2 || >=0.2.1-0 || >=0.2.2-0",
    "@deepseek-ai/schemastery": "^3.18.1 || 3.18.5-alpha.1 || 3.18.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.3",
    "@deepseek-ai/dsh-web": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "@types/semver": "^7.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semver": "^7.8.5",
    "tsdown": "^0.15.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "undici": "^7.0.0"
  }
}
